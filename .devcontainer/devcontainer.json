{
  "name": "GitGuardian Code 101",

  // Ready-made image: git, gh, Node, Claude Code and ggshield preinstalled
  // and pinned, with the Claude Code AI hook already configured.
  // Source: image/Dockerfile in the workshop prep folder (not in this repo).
  "image": "ghcr.io/jordanmontee-alikel/code101-codespace:1",
  "remoteUser": "vscode",

  // Claude Code: don't auto-install its VS Code extension (welcome screen,
  // side panel, steals terminal focus) and skip the feedback survey.
  "containerEnv": {
    "CLAUDE_CODE_IDE_SKIP_AUTO_INSTALL": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1"
  },

  // Smallest machine is plenty and keeps free-tier usage low.
  "hostRequirements": { "cpus": 2 },

  // Per-repo setup (~1 second): pre-commit hook, Claude Code tweaks, welcome.
  "postCreateCommand": "bash .devcontainer/post-create.sh",

  "customizations": {
    "codespaces": {
      "openFiles": ["README.md"]
    },
    "vscode": {
      "settings": {
        // No "Do you trust the authors?" popup blocking the terminal.
        "security.workspace.trust.enabled": false,
        // Hide Copilot chat panel and AI hints: Claude Code is the only assistant here.
        "chat.disableAIFeatures": true,
        "workbench.secondarySideBar.defaultVisibility": "hidden",
        // Open the README formatted, not as raw Markdown.
        "workbench.editorAssociations": { "*.md": "vscode.markdown.preview.editor" },
        "workbench.startupEditor": "none",
        "terminal.integrated.defaultProfile.linux": "bash",
        "git.confirmSync": false
      }
    }
  }
}
